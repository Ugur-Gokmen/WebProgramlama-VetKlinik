@model IEnumerable<Randevu>
@{
    ViewData["Title"] = "Randevularım";
}
<div class="d-flex justify-content-between mb-3">
    <h1 class="h4">Randevularım</h1>
    <a class="btn btn-pati" asp-action="Olustur">Yeni randevu</a>
</div>
<table class="table bg-white">
    <thead><tr><th>Tarih</th><th>Hayvan</th><th>Hizmet</th><th>Hekim</th><th>Durum</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Baslangic.ToString("g")</td>
            <td>@r.EvcilHayvan.Ad</td>
            <td>@r.Hizmet.Ad</td>
            <td>@r.Veteriner.AdSoyad</td>
            <td>@r.Durum</td>
            <td><a asp-action="Detay" asp-route-id="@r.Id">Detay</a></td>
        </tr>
    }
    </tbody>
</table>
