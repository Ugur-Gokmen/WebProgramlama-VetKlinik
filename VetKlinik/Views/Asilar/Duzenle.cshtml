@model AsiFormViewModel
@{
    ViewData["Title"] = "Aşı düzenle";
}
<div class="card kart p-4 col-md-6">
    <h1 class="h4">Aşı düzenle</h1>
    <form method="post">
        <input type="hidden" asp-for="EvcilHayvanId" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-2"><label asp-for="AsiAdi" class="form-label"></label><input asp-for="AsiAdi" class="form-control" /></div>
        <div class="mb-2"><label asp-for="YapildigiTarih" class="form-label"></label><input asp-for="YapildigiTarih" class="form-control" /></div>
        <div class="mb-3"><label asp-for="SonrakiDozTarihi" class="form-label"></label><input asp-for="SonrakiDozTarihi" class="form-control" /></div>
        <button class="btn btn-pati">Kaydet</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
