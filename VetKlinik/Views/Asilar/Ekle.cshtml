@model AsiFormViewModel
@{
    ViewData["Title"] = "Aşı ekle";
}
<div class="card kart p-4 col-md-6">
    <h1 class="h4">@ViewBag.HayvanAd için aşı</h1>
    <form method="post">
        <input type="hidden" asp-for="EvcilHayvanId" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-2"><label asp-for="AsiAdi" class="form-label"></label><input asp-for="AsiAdi" class="form-control" /><span asp-validation-for="AsiAdi" class="text-danger"></span></div>
        <div class="mb-2"><label asp-for="YapildigiTarih" class="form-label"></label><input asp-for="YapildigiTarih" class="form-control" /><span asp-validation-for="YapildigiTarih" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="SonrakiDozTarihi" class="form-label"></label><input asp-for="SonrakiDozTarihi" class="form-control" /><span asp-validation-for="SonrakiDozTarihi" class="text-danger"></span></div>
        <button class="btn btn-pati">Kaydet</button>
        <a class="btn btn-link" asp-controller="Hayvanlar" asp-action="Detay" asp-route-id="@Model.EvcilHayvanId">İptal</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
