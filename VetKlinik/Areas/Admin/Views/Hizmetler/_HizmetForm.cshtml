@model Hizmet
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="KlinikId" class="form-label">Klinik</label>
        <select asp-for="KlinikId" asp-items="ViewBag.Klinikler" class="form-select"></select>
    </div>
    <div class="mb-2"><label asp-for="Ad" class="form-label"></label><input asp-for="Ad" class="form-control" /></div>
    <div class="mb-2"><label asp-for="SureDakika" class="form-label"></label><input asp-for="SureDakika" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Ucret" class="form-label"></label><input asp-for="Ucret" class="form-control" /></div>
    <button class="btn btn-pati">Kaydet</button>
</form>
