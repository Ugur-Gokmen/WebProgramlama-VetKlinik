@model Hizmet
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="KlinikId" class="form-label">Klinik</label>
        <select asp-for="KlinikId" asp-items="ViewBag.Klinikler" class="form-select"></select>
        <span asp-validation-for="KlinikId" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="SureDakika" class="form-label"></label>
        <input asp-for="SureDakika" class="form-control" type="number" min="15" max="240" />
        <span asp-validation-for="SureDakika" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Ucret" class="form-label"></label>
        <input asp-for="Ucret" class="form-control" type="number" step="0.01" min="0" max="100000" />
        <span asp-validation-for="Ucret" class="text-danger small"></span>
    </div>
    <button class="btn btn-pati">Kaydet</button>
</form>
